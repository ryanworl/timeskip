+}
+
+/// _IOW(KVMIO, 0xe2, struct kvm_device_attr)
+#[cfg(target_arch = "x86_64")]
+const KVM_GET_DEVICE_ATTR: libc::c_ulong = 0x4018_aee2;
+/// _IOW(KVMIO, 0xe1, struct kvm_device_attr)
+#[cfg(target_arch = "x86_64")]
+const KVM_SET_DEVICE_ATTR: libc::c_ulong = 0x4018_aee1;
+
+/// Sets the guest TSC to `tsc` through the vCPU's TSC offset
+/// (KVM_VCPU_TSC_OFFSET). (KVM takes a write of IA32_TSC within a second of
+/// the value it expects for a sync, and leaves the TSC running.)
+#[cfg(target_arch = "x86_64")]
+fn set_guest_tsc(vcpu: &crate::arch::x86_64::vcpu::KvmVcpu, tsc: u64) -> Result<(), String> {
+    use crate::arch::x86_64::generated::msr_index::MSR_IA32_TSC;
+    let mut offset = 0u64;
+    let mut attr = kvm_bindings::kvm_device_attr {
+        flags: 0,
+        group: kvm_bindings::KVM_VCPU_TSC_CTRL,
+        attr: u64::from(kvm_bindings::KVM_VCPU_TSC_OFFSET),
+        addr: &mut offset as *mut u64 as u64,
+    };
+    // SAFETY: a vCPU fd, and attr points at offset, which outlives the call.
+    if unsafe { vmm_sys_util::ioctl::ioctl_with_ref(&vcpu.fd, KVM_GET_DEVICE_ATTR, &attr) } != 0 {
+        return Err(format!("KVM_GET_DEVICE_ATTR: {}", io::Error::last_os_error()));
+    }
+    let now = vcpu
+        .get_msrs([MSR_IA32_TSC].into_iter())
+        .map_err(|err| err.to_string())?
+        .get(&MSR_IA32_TSC)
+        .copied()
+        .ok_or_else(|| "no IA32_TSC".to_string())?;
+    let offset = offset.wrapping_add(tsc).wrapping_sub(now);
+    attr.addr = &offset as *const u64 as u64;
+    // SAFETY: as above.
+    if unsafe { vmm_sys_util::ioctl::ioctl_with_ref(&vcpu.fd, KVM_SET_DEVICE_ATTR, &attr) } != 0 {
+        return Err(format!("KVM_SET_DEVICE_ATTR: {}", io::Error::last_os_error()));
+    }
+    Ok(())
+}
