+void timekeeping_skip(u64 nsecs)
+{
+	struct timekeeper *tk = &shadow_timekeeper;
+	struct tk_read_base *tkr = &tk->tkr_mono;
+	unsigned long flags;
+	u64 cycles;
+
+	raw_spin_lock_irqsave(&timekeeper_lock, flags);
+	cycles = mul_u64_u64_div_u64(nsecs, 1ULL << tkr->shift, tkr->mult) + 1;
+	tkr->cycle_last = (tkr->cycle_last - cycles) & tkr->mask;
+	tk->tkr_raw.cycle_last = tkr->cycle_last;
+	raw_spin_unlock_irqrestore(&timekeeper_lock, flags);
+
+	if (timekeeping_advance(TK_ADV_FREQ))
+		clock_was_set_delayed();
+}
