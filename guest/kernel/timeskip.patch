+/*
+ * Lose each 4 KiB block of the writes since the last flush with probability
+ * one half: the newest first, so that a block lost reads as it did before
+ * them all.
+ */
+static void timeskip_cut(struct loop_device *lo)
+{
+	struct timeskip_write *w, *t;
+	u64 salt = get_random_u64();
+
+	mutex_lock(&lo->ts_mutex);
+	list_for_each_entry_safe_reverse(w, t, &lo->ts_writes, list) {
+		loff_t p = w->pos;
