+			if (hash_64((p >> 12) ^ salt, 1))
+				kernel_write(lo->lo_backing_file,
+					     w->old + (p - w->pos), end - p, &q);
+			p = end;
+		}
+		timeskip_drop(lo, w);
+	}
+	mutex_unlock(&lo->ts_mutex);
+}
