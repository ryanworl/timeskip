+	if (p->flags & (PF_KTHREAD | PF_USER_WORKER | PF_EXITING) ||
+	    p->timeskip_pause_ns || !task_dfl_cgroup(p)->level)
+		return;
+	r = timeskip_pause_next();
+	if (r & (odds - 1))
+		return;
