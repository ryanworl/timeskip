+ * A node's disk, for the time-skip guest agent, is a loop device with faults
+ * of its own (in sysfs, under loop/):
+ *
+ * - timeskip_fail: the parts per million of its data's reads and writes to
+ *   fail with EIO, as a failing disk's, and of the metadata operations on
+ *   its filesystem (see timeskip_meta_fail); timeskip_failed counts them.
+ *   A read that fails leaves a 4 KiB block of it bad, as a latent sector
+ *   error does: reads of it fail until it's written (and so remapped) or
+ *   timeskip_fail is written again (TIMESKIP_BAD blocks at most).
+ *   Not its filesystem's own metadata I/O (REQ_META, as the journal's
+ *   writes are, or in the block device's page cache): a failing disk's
+ *   errors stay the systems' to handle, not a broken filesystem's.
+ * - timeskip_cache: writing it turns on a volatile write cache, for good.
+ *   The writes since the last flush
+ *   are kept (their blocks' old contents are), and writing timeskip_cut, as
+ *   the power is cut (with nothing mounted), loses each 4 KiB block of them
+ *   with probability one half: it reads as it did before them. A disk's
+ *   cache holds TIMESKIP_CACHE bytes at most: older writes are durable.
+ */
+#define TIMESKIP_CACHE (64 << 20)
+#define TIMESKIP_BAD 4096
+
+struct timeskip_write {
+	struct list_head	list;
+	u64			gen;	/* the flushes begun before it */
+	loff_t			pos;
+	size_t			len;
+	char			old[];
+};
+
+static bool timeskip_fail(struct loop_device *lo, struct request *rq)
+{
+	unsigned int ppm = READ_ONCE(lo->ts_fail);
+	bool read = req_op(rq) == REQ_OP_READ, fail;
+	unsigned long b, first, last;
+	struct address_space *m;
+	struct bio *bio;
+
+	if (!ppm || !rq->bio)
+		return false;
+	first = blk_rq_pos(rq) >> 3;
+	last = (blk_rq_pos(rq) + blk_rq_sectors(rq) - 1) >> 3;
+	if (req_op(rq) == REQ_OP_WRITE_ZEROES) { /* (bad blocks written) */
+		for (b = first; !xa_empty(&lo->ts_bad) && b <= last; b++)
+			if (xa_erase(&lo->ts_bad, b))
+				atomic_dec(&lo->ts_nbad);
+		return false;
+	}
+	if (!read && req_op(rq) != REQ_OP_WRITE)
+		return false;
+	/* (Any of its bios: a request merges the filesystem's with data's.) */
+	__rq_for_each_bio(bio, rq) {
+		if (bio->bi_opf & REQ_META)
+			return false;
+		m = folio_mapping(page_folio(bio_first_page_all(bio)));
+		if (m && S_ISBLK(m->host->i_mode))
+			return false;
+	}
+	fail = get_random_u32_below(1000000) < ppm;
+	if (read && fail && atomic_read(&lo->ts_nbad) < TIMESKIP_BAD) {
+		b = first + get_random_u32_below(last - first + 1);
+		if (!xa_insert(&lo->ts_bad, b, xa_mk_value(1), GFP_NOIO))
+			atomic_inc(&lo->ts_nbad);
+	}
+	for (b = first; !xa_empty(&lo->ts_bad) && !fail && b <= last; b++) {
+		if (read)
+			fail = xa_load(&lo->ts_bad, b);
+		else if (xa_erase(&lo->ts_bad, b))
+			atomic_dec(&lo->ts_nbad);
+	}
+	if (fail)
+		atomic64_inc(&lo->ts_failed);
+	return fail;
+}
+
+/* No block is bad any more. */
+static void timeskip_unbad(struct loop_device *lo)
+{
+	xa_destroy(&lo->ts_bad);
+	atomic_set(&lo->ts_nbad, 0);
+}
+
+/*
+ * Whether to fail a metadata operation on a filesystem on a node's disk,
+ * with EIO, as timeskip_fail fails its data's reads and writes: creating,
+ * removing or renaming a file, or fsyncing a directory (see fs/namei.c and
+ * fs/sync.c). It fails before it changes anything: the filesystem stays
+ * whole, and the caller sees the error a failing disk's would give it.
+ */
+bool timeskip_meta_fail(struct super_block *sb)
+{
+	struct loop_device *lo;
+	unsigned int ppm;
+	bool guest;
+
+	if (!sb->s_bdev || sb->s_bdev->bd_disk->major != LOOP_MAJOR)
+		return false;
+	/*
+	 * (Not the guest's own, in the root cgroup: Docker's, as it mounts a
+	 * container's overlay, which would come up read-only.)
+	 */
+	rcu_read_lock();
+	guest = !task_dfl_cgroup(current)->level;
+	rcu_read_unlock();
+	if (guest)
+		return false;
+	lo = sb->s_bdev->bd_disk->private_data;
+	ppm = READ_ONCE(lo->ts_fail);
+	if (!ppm || get_random_u32_below(1000000) >= ppm)
+		return false;
+	atomic64_inc(&lo->ts_failed);
+	return true;
+}
+
+static void timeskip_drop(struct loop_device *lo, struct timeskip_write *w)
+{
+	list_del(&w->list);
+	lo->ts_bytes -= w->len;
+	kvfree(w);
+}
+
+/* Keep what a write of len bytes at pos is about to overwrite. */
+static void timeskip_record(struct loop_device *lo, loff_t pos, size_t len)
+{
+	struct timeskip_write *w;
+	loff_t p = pos;
+	ssize_t n;
+
+	if (!READ_ONCE(lo->ts_cache) || len > TIMESKIP_CACHE)
+		return;
+	w = kvmalloc(struct_size(w, old, len), GFP_NOIO);
+	if (!w)
+		return; /* (it's durable) */
+	n = kernel_read(lo->lo_backing_file, w->old, len, &p);
+	if (n < 0) {
+		kvfree(w);
+		return;
+	}
+	memset(w->old + n, 0, len - n); /* (past the end of the file) */
+	w->pos = pos;
+	w->len = len;
+	mutex_lock(&lo->ts_mutex);
+	w->gen = lo->ts_gen;
+	list_add_tail(&w->list, &lo->ts_writes);
+	lo->ts_bytes += len;
+	while (lo->ts_bytes > TIMESKIP_CACHE)
+		timeskip_drop(lo, list_first_entry(&lo->ts_writes,
+						   struct timeskip_write, list));
+	mutex_unlock(&lo->ts_mutex);
+}
+
+/* A flush makes the writes recorded before it began durable. */
+static int timeskip_flush(struct loop_device *lo, struct request *rq)
+{
+	struct timeskip_write *w, *t;
+	u64 gen;
+	int ret;
+
+	mutex_lock(&lo->ts_mutex);
+	gen = lo->ts_gen++;
+	mutex_unlock(&lo->ts_mutex);
+	ret = lo_req_flush(lo, rq);
+	if (ret)
+		return ret;
+	mutex_lock(&lo->ts_mutex);
+	list_for_each_entry_safe(w, t, &lo->ts_writes, list)
+		if (w->gen <= gen)
+			timeskip_drop(lo, w);
+	mutex_unlock(&lo->ts_mutex);
+	return 0;
+}
