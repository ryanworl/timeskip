#!/bin/sh
# Guest init: bring up dockerd entirely inside the VM (no network device), run
# the guest agent (/timeskip-guest), then power off. The root filesystem is a
# read-only image; what's written goes to tmpfs or the data disk.
export PATH=/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
mount -t proc proc /proc
mount -t sysfs sysfs /sys
# Zero memory as it's freed until the agent saves the set-up system, so the
# save holds no stale data (see freeze in cmd/guest).
echo Y >/sys/module/kernel/parameters/timeskip_zero_free
mkdir -p /dev/pts /dev/shm
mount -t devpts devpts /dev/pts
mount -t tmpfs tmpfs /dev/shm
mount -t tmpfs tmpfs /run
mount -t tmpfs tmpfs /tmp
mount -t cgroup2 cgroup2 /sys/fs/cgroup
mount --make-rshared /
# Timers of every process (inherited from here) may fire up to 1 ms late, so
# that the Go runtimes' short sleeps and the like share timer interrupts:
# each costs the host two VM exits, and a guest that waits skips the time.
echo 1000000 >/proc/$$/timerslack_ns
ip link set lo up

up() { cut -d' ' -f1 /proc/uptime; }
log() { echo "[guest $(up)s] $*"; }

# The second disk holds /var/lib/docker. Booting (for the base checkpoint, the
# only boot) it's blank, a new file of zeros: format it, writing only the
# metadata (and marking the inode tables zeroed, so the kernel doesn't zero
# them later). Its last GiB of 64 is left out, for a failed timeline's
# container logs (protocol.ContainerLogsAt).
mkfs.ext4 -q -F -L dockerdata -E assume_storage_prezeroed=1,nodiscard /dev/vdb 63G
mount -t ext4 -o noatime /dev/vdb /var/lib/docker

log "boot complete; starting dockerd"
# Limits as a Docker host's (docker.service: LimitNOFILE=infinity and so
# on), which containers inherit; and vm.max_map_count as Elasticsearch and
# the like want it.
# shellcheck disable=SC3045 # (BusyBox sh has them)
{ ulimit -n 1048576; ulimit -u unlimited; ulimit -c unlimited; }
echo 262144 >/proc/sys/vm/max_map_count
# On arm64, linux/amd64 images run emulated, by QEMU, which the kernel opens
# now (F), so that it runs in any container.
if [ -x /usr/bin/qemu-x86_64 ]; then
  mount -t binfmt_misc binfmt_misc /proc/sys/fs/binfmt_misc
  printf '%s' ':qemu-x86_64:M::\x7fELF\x02\x01\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x02\x00\x3e\x00:\xff\xff\xff\xff\xff\xfe\xfe\x00\xff\xff\xff\xff\xff\xff\xff\xff\xfe\xff\xff\xff:/usr/bin/qemu-x86_64:POCF' >/proc/sys/fs/binfmt_misc/register
fi
# Docker networking (bridge networks, service-name DNS, published ports by
# docker-proxy), without the iptables rules a host needs for outside traffic:
# nothing leaves the VM, and nothing routes between networks either, since forwarding is off on
# every interface made from here on. (ip_forward reads 1, so dockerd doesn't
# warn that networking won't work.) overlay2 instead of the containerd image
# store keeps one copy of each layer in memory. crun starts a container in a
# third of runc's time. The binaries are read as they run: what's read and not
# mapped is dropped before the save anyway.
echo 1 >/proc/sys/net/ipv4/ip_forward
echo 0 >/proc/sys/net/ipv4/conf/default/forwarding
dockerd --ip6tables=false --iptables=false --ip-forward=false \
  --add-runtime crun=/usr/local/bin/crun --default-runtime crun \
  --storage-driver=overlay2 --log-level=error >/run/dockerd.log 2>&1 &
# (The agent waits for dockerd's API.)
/timeskip-guest

log "finished; powering off"
sync
# Wait until the console has sent everything (busybox stty sets modes with
# TCSADRAIN); otherwise the reboot can cut off the EXIT line.
stty -F /dev/console onlcr
if [ "$(uname -m)" = x86_64 ]; then reboot -f; else poweroff -f; fi
